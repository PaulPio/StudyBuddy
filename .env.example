# Copy this file to .env and fill in real values. Never commit .env.
BOXLANG_CONFIG=./config/boxlang.json

# Pick ONE provider for the hackathon. OpenAI is the easiest to demo with.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
OPENAI_API_KEY=sk-your-key-here

# If someone prefers a free local model instead:
# AI_PROVIDER=ollama
# AI_MODEL=llama3.2

# Used by src/rag (Person 2) for the vector store, if a hosted one is used
# instead of an in-memory/local one. Leave blank to use local memory.
VECTOR_DB_URL=
