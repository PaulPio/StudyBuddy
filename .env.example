# StudyBuddy - AI provider credentials.
# Copy to .env and fill in a real key. NEVER commit a real key.
# boxlang.json reads ${GEMINI_API_KEY}; bx-ai also auto-detects the per-provider variable.

GEMINI_API_KEY=your-gemini-api-key-here

# Only needed if you switch "provider" in boxlang.json:
# OPENAI_API_KEY=your-openai-api-key-here
# CLAUDE_API_KEY=your-claude-api-key-here

# Tests use the built-in bx-ai "mock" provider and need no key at all.
