/**
 * Contract for Person 2's document/RAG store.
 *
 * This is not meant to be used directly - it documents the exact method
 * signatures `src/rag/DocumentStore.bx` needs to implement so that
 * `StudyBuddyService` and the quiz generator can rely on it. It also
 * backs `MockDocumentStore`, which implements the same shape with fake
 * data so the rest of the app runs before the real thing exists.
 *
 * Do not edit this file without telling Person 2 - it's the handshake
 * between src/rag/ and src/integration/.
 */
class {

    /**
     * Load a folder of course material into the vector store.
     *
     * @path    Folder to ingest, e.g. "sample-data".
     * @options Loader options, e.g. { recursive: true, extensions: ["md","txt","pdf"] }.
     *
     * @return struct { documentsIn: numeric, chunksOut: numeric, stored: numeric }
     */
    public struct function ingestFolder( required string path, struct options = {} ) {
        throw(
            type    = "NotImplementedException",
            message = "IDocumentStore.ingestFolder() must be implemented by src/rag/DocumentStore.bx"
        );
    }

    /**
     * Semantic search over ingested course material.
     *
     * @query Natural-language query.
     * @limit Max number of chunks to return.
     *
     * @return array of struct {
     *     content: string,
     *     source: string,     // full path, e.g. "sample-data/lecture02-normalization.md"
     *     fileName: string,   // e.g. "lecture02-normalization.md"
     *     page: numeric,      // 0 when the format has no pages (md/txt)
     *     score: numeric      // similarity score, higher = more relevant
     * }
     */
    public array function search( required string query, numeric limit = 5 ) {
        throw(
            type    = "NotImplementedException",
            message = "IDocumentStore.search() must be implemented by src/rag/DocumentStore.bx"
        );
    }

}
