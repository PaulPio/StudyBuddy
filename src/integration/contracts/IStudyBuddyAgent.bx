/**
 * Contract for Person 1's BX Agent.
 *
 * Documents the exact method signature `src/agent/StudyBuddyAgent.bx`
 * needs to implement so `StudyBuddyService` and the quiz generator can
 * rely on it, and backs `MockStudyBuddyAgent` for standalone testing.
 *
 * Do not edit this file without telling Person 1 - it's the handshake
 * between src/agent/ and src/integration/.
 */
class {

    /**
     * Answer a student's question using only the ingested course material.
     *
     * @question Natural-language question from the student.
     * @courseId Optional - scopes the answer to one course/collection.
     * @history  Optional - prior turns in this conversation, oldest first,
     *           each { role: "user"|"assistant", content: string }.
     *
     * @return struct {
     *     answer: string,
     *     sources: array of { document: string, page: numeric },
     *     confidence: string   // "high" | "medium" | "low"
     * }
     */
    public struct function ask(
        required string question,
        string courseId = "",
        array history = []
    ) {
        throw(
            type    = "NotImplementedException",
            message = "IStudyBuddyAgent.ask() must be implemented by src/agent/StudyBuddyAgent.bx"
        );
    }

}
