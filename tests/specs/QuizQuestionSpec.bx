import src.quiz.QuizQuestion;

class extends="testbox.system.BaseSpec" {

    function run() {
        describe( "QuizQuestion", () => {

            it( "generates a unique id on init", () => {
                var q1 = new QuizQuestion();
                var q2 = new QuizQuestion();
                expect( q1.getId() ).notToBe( q2.getId() );
            } );

            it( "hides the answer key in toPublicStruct()", () => {
                var q = new QuizQuestion();
                q.setQuestion( "What is a foreign key?" );
                q.setChoices( [ "A", "B", "C", "D" ] );
                q.setCorrectIndex( 2 );
                q.setExplanation( "Because reasons." );

                var pub = q.toPublicStruct();

                expect( pub ).toHaveKey( "question" );
                expect( pub ).toHaveKey( "choices" );
                expect( pub ).notToHaveKey( "correctIndex" );
                expect( pub ).notToHaveKey( "explanation" );
            } );

            it( "includes the answer key and source in toFullStruct()", () => {
                var q = new QuizQuestion();
                q.setCorrectIndex( 3 );
                q.setSourceDocument( "lecture01-intro-to-databases.md" );
                q.setSourcePage( 1 );

                var full = q.toFullStruct();

                expect( full.correctIndex ).toBe( 3 );
                expect( full.sourceDocument ).toBe( "lecture01-intro-to-databases.md" );
                expect( full.sourcePage ).toBe( 1 );
            } );

        } );
    }

}
