{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://studybuddy.local/schemas/study-answer.schema.json",
  "title": "StudyAnswer",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "requestId",
    "status",
    "answer",
    "claimType",
    "confidence",
    "citations",
    "conflicts",
    "suggestedNextStep",
    "error"
  ],
  "properties": {
    "requestId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "insufficient_evidence",
        "conflicting_evidence",
        "error"
      ]
    },
    "answer": {
      "type": "string",
      "minLength": 1
    },
    "claimType": {
      "type": "string",
      "enum": [
        "fact",
        "inference",
        "mixed",
        "unknown"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "citations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/citation"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/conflict"
      }
    },
    "suggestedNextStep": {
      "type": [
        "string",
        "null"
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidenceId",
        "documentName",
        "page",
        "section"
      ],
      "properties": {
        "evidenceId": {
          "type": "string",
          "minLength": 1
        },
        "documentName": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "section": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "description",
        "evidenceIds"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "evidenceIds": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "RETRIEVAL_UNAVAILABLE",
            "MODEL_UNAVAILABLE",
            "MODEL_OUTPUT_INVALID",
            "INTERNAL_ERROR"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
